// All portal tables live in the dedicated "prime" Postgres schema on Supabase.
// Every model is soft-deleted via deletedAt; application reads filter deletedAt IS NULL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["prime"]
}

enum Role {
  product
  developer

  @@schema("prime")
}

enum AssessmentStatus {
  discovery
  findings
  plan
  plan_submitted @map("plan-submitted")
  agreed

  @@schema("prime")
}

enum DiscoveryStatus {
  in_progress @map("in-progress")
  submitted

  @@schema("prime")
}

model Profile {
  /// Same id as the Supabase auth user.
  id                 String    @id @db.Uuid
  email              String    @unique
  name               String
  role               Role
  /// Set when product creates the account or resets its password; cleared once the user picks their own.
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  gamesCreated       Game[]               @relation("GameCreatedBy")
  assessmentsUpdated Assessment[]         @relation("AssessmentUpdatedBy")
  snapshotsCreated   AssessmentSnapshot[] @relation("SnapshotCreatedBy")
  discoveryResponses DiscoveryResponse[]

  @@schema("prime")
}

model Game {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy          Profile             @relation("GameCreatedBy", fields: [createdById], references: [id])
  assessment         Assessment?
  discoveryResponses DiscoveryResponse[]

  @@index([deletedAt])
  @@schema("prime")
}

model Assessment {
  id          String           @id @default(uuid()) @db.Uuid
  gameId      String           @unique @db.Uuid
  state       Json
  status      AssessmentStatus @default(discovery)
  /// Optimistic locking: a save must send the version it was based on.
  version     Int              @default(1)
  updatedById String           @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  game      Game                 @relation(fields: [gameId], references: [id])
  updatedBy Profile              @relation("AssessmentUpdatedBy", fields: [updatedById], references: [id])
  snapshots AssessmentSnapshot[]

  @@schema("prime")
}

model AssessmentSnapshot {
  id           String           @id @default(uuid()) @db.Uuid
  assessmentId String           @db.Uuid
  status       AssessmentStatus
  state        Json
  createdById  String           @db.Uuid
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  createdBy  Profile    @relation("SnapshotCreatedBy", fields: [createdById], references: [id])

  @@index([assessmentId, createdAt])
  @@schema("prime")
}

/// One developer's discovery answers for one game. At most one active row (deletedAt IS NULL) per
/// game and developer: enforced by a partial unique index created in the migration SQL, which the
/// Prisma schema cannot express. Removing a response is a soft delete; the developer then starts afresh.
model DiscoveryResponse {
  id          String          @id @default(uuid()) @db.Uuid
  gameId      String          @db.Uuid
  profileId   String          @db.Uuid
  answers     Json
  status      DiscoveryStatus @default(in_progress)
  /// Optimistic locking for answer saves.
  version     Int             @default(1)
  submittedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  game    Game    @relation(fields: [gameId], references: [id])
  profile Profile @relation(fields: [profileId], references: [id])

  @@index([gameId, profileId])
  @@schema("prime")
}
