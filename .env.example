# Copy to .env.local for local development. Never commit real values.

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connections (Project Settings → Database → Connection string)
# Pooled (transaction pooler), port 6543, with ?pgbouncer=true
DATABASE_URL=
# Session pooler, port 5432 — used by prisma migrate deploy
DIRECT_URL=

# Email of the first product user; their profile is created on first login.
PRIME_BOOTSTRAP_PRODUCT_EMAIL=
